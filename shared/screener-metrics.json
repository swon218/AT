    "ema":{"title":"가격 지수이동평균선 (EMA)","group":"price","target":"sma"},
    "rsi":{"title":"RSI","group":"rsi","target":"rsi","reference":[30,70]},
    "bb_lower":{"title":"볼린저밴드 하단","group":"price","target":"sma"},
    "bb_middle":{"title":"볼린저밴드 중심","group":"price","target":"sma"},
    "bb_upper":{"title":"볼린저밴드 상단","group":"price","target":"sma"},
    "volume_sma":{"title":"거래량 이동평균 (SMA)","group":"volume","target":"volume"},
    "macd":{"title":"MACD","group":"macd","target":"macd_signal"},
    "macd_signal":{"title":"MACD 시그널","group":"macd","target":"macd"},
    "macd_histogram":{"title":"MACD 히스토그램","group":"macd","target":"macd_signal"},
    "atr":{"title":"ATR 평균진폭","group":"atr","target":"atr"},
    "atr_percent":{"title":"ATR%","group":"atr_percent","target":"atr_percent"},
    "adx":{"title":"ADX","group":"adx","target":"adx","reference":[20,25]},
    "plus_di":{"title":"+DI","group":"di","target":"minus_di"},
    "minus_di":{"title":"−DI","group":"di","target":"plus_di"},
    "stoch_k":{"title":"스토캐스틱 %K","group":"stochastic","target":"stoch_d","reference":[20,80]},
    "stoch_d":{"title":"스토캐스틱 %D","group":"stochastic","target":"stoch_k","reference":[20,80]},
    "obv":{"title":"OBV 누적거래량","group":"obv","target":"obv_ma"},
    "obv_ma":{"title":"OBV 누적거래량 평균","group":"obv","target":"obv"},
    "mfi":{"title":"MFI","group":"mfi","target":"mfi","reference":[20,80]},
    "cci":{"title":"CCI","group":"cci","target":"cci","reference":[-100,100]},
    "supertrend":{"title":"슈퍼트렌드 가격선","group":"price","target":"sma"},
    "supertrend_direction":{"title":"슈퍼트렌드 방향","group":"direction","states":{"1":"상승","-1":"하락"}},
    "supertrend_flip":{"title":"슈퍼트렌드 전환","group":"flip","states":{"1":"상승 전환","-1":"하락 전환","0":"변화 없음"}}
  }
}
