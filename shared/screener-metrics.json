{
  "version": "screen-units-v1",
  "groups": {
    "price": {"unit":"원","domain":"price","min":0,"max":1000000000000,"ratio":true,"default":10000,"operator":"gte","guide":"가격과 가격 이동평균·밴드·슈퍼트렌드 가격선만 비교합니다. 평균값의 소수는 유지하며 주문 호가단위를 적용하지 않습니다."},
    "volume": {"unit":"주","domain":"volume","min":0,"max":1000000000000,"ratio":true,"default":100000,"operator":"gte","guide":"거래량과 거래량 이동평균만 비교합니다. 평균 거래량은 현재 확정 봉을 포함한 N개 거래일의 산술평균이며 소수가 있을 수 있습니다. 가격 이동평균이나 누적 OBV와 비교하지 않습니다."},
    "atr": {"unit":"원","domain":"volatility_price","min":0,"max":1000000000000,"ratio":true,"default":100,"operator":"gte","guide":"ATR은 가격 방향이 아닌 진폭입니다. 다른 기간의 ATR과 비교할 수 있으며 종가·가격 이동평균과는 비교하지 않습니다."},
    "atr_percent": {"unit":"%","domain":"volatility_percent","min":0,"max":1000000000000,"ratio":false,"default":3,"operator":"gte","guide":"ATR% = ATR ÷ 같은 확정 봉의 종가 × 100입니다. 기준값 3은 ATR% 3%이며 이미 계산된 값을 다시 100배 변환하지 않습니다."},
    "rsi": {"unit":"지수","domain":"bounded_index","min":0,"max":100,"ratio":false,"default":30,"operator":"lte","guide":"0~100의 모멘텀 지수이며 주가 수익률이 아닙니다. RSI끼리 비교합니다. 30·70은 통상 참고 기준이며 반전이나 수익을 보장하지 않습니다."},
    "mfi": {"unit":"지수","domain":"bounded_index","min":0,"max":100,"ratio":false,"default":20,"operator":"lte","guide":"가격과 거래량으로 계산한 0~100 지수입니다. 실제 자금 유입액이나 주가 수익률이 아닙니다. MFI끼리 비교하며 20·80은 통상 참고 기준입니다."},
    "adx": {"unit":"지수","domain":"bounded_index","min":0,"max":100,"ratio":false,"default":25,"operator":"gte","guide":"0~100의 추세 강도입니다. 상승·하락 방향이나 수익률을 뜻하지 않습니다. ADX끼리 비교하며 20·25는 통상 참고 기준입니다."},
    "di": {"unit":"지수","domain":"bounded_index","min":0,"max":100,"ratio":false,"default":25,"operator":"gte","guide":"+DI·−DI는 평활한 방향 움직임과 진폭의 비율을 0~100으로 나타냅니다. 서로 비교할 수 있지만 ADX·RSI·MFI와 같은 지수라고 혼합하지 않습니다."},
    "stochastic": {"unit":"지수","domain":"bounded_index","min":0,"max":100,"ratio":false,"default":20,"operator":"lte","guide":"%K·%D는 최근 고저 범위에서의 상대 위치와 평활선입니다. 0~100 지수이며 주가 등락률이 아닙니다. K·D끼리 비교합니다. 20·80은 통상 참고 기준입니다."},
    "macd": {"unit":"원","domain":"price_difference","min":-1000000000000,"max":1000000000000,"ratio":false,"default":0,"operator":"gte","guide":"MACD·시그널·히스토그램은 가격 차이 계열로 음수와 0이 의미 있습니다. 세 출력끼리 비교하며 가격 수준·ATR과 비교하지 않습니다."},
    "cci": {"unit":"지수","domain":"unbounded_index","min":-1000000000000,"max":1000000000000,"ratio":false,"default":-100,"operator":"lte","guide":"CCI는 평균절대편차로 정규화한 지수이며 0~100 제한이 없습니다. 음수도 입력할 수 있습니다. ±100은 통상 참고선이며 유일한 정답이 아닙니다."},
    "obv": {"unit":"주(누적)","domain":"cumulative_volume","min":-1000000000000,"max":1000000000000,"ratio":false,"default":0,"operator":"gte","guide":"OBV와 OBV 평균은 누적거래량이며 음수와 0도 의미 있습니다. 같은 종목·계산 이력에서 서로 비교합니다. 일반 거래량이나 평균 거래량과 비교하지 않습니다. 시작점이 다른 종목 간 절대값 비교에도 주의하세요."},
    "direction": {"unit":"상태","domain":"state","ratio":false,"default":1,"operator":"eq","guide":"이 구현의 내부 코드는 1 상승, −1 하락입니다. 가격선과 구분하며 상태에는 배수·퍼센트를 적용하지 않습니다."},
    "flip": {"unit":"상태","domain":"state","ratio":false,"default":1,"operator":"eq","guide":"이 구현의 내부 코드는 1 상승 전환, −1 하락 전환, 0 변화 없음입니다. 첫 유효 방향의 시작도 전환 0으로 계산합니다. 상태에는 배수·퍼센트를 적용하지 않습니다."}
  },
  "metrics": {
    "open":{"title":"시가","group":"price","target":"sma"},
