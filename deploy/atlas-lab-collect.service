[Unit]
Description=ATLAS 21:00 primary daily candle collection
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=atlas
Group=atlas
WorkingDirectory=/opt/atlas
Environment=LAB_DB_PATH=/var/lib/atlas/lab.sqlite
EnvironmentFile=-/etc/atlas/lab-kiwoom.env
Environment=DOTENV_CONFIG_PATH=/dev/null
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/atlas/.venv-lab/bin/python /opt/atlas/lab/nightly.py primary --max-minutes 250
SuccessExitStatus=2
TimeoutStartSec=270min
KillMode=control-group
UMask=0027
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atlas
