kiwoom_app_key=
kiwoom_secret_key=
KIWOOM_ORDERS_ENABLED=false

toss_api_key=
toss_secret_key=
TOSS_ORDERS_ENABLED=false

NH_app_key=
NH_secret_key=
NH_ORDERS_ENABLED=false
# 나무 PLUG 운영 주소. 모의 계좌 사용 시 https://moapi.nhplug.com:8443
NH_API_HOST=https://api.nhplug.com:8443

KB_app_key=
KB_secret_key=
KB_ORDERS_ENABLED=false
# KB 요청 dataHeader에 넣을 실제 VPS 송신 IP와 네트워크 인터페이스 MAC
KB_CLIENT_IP=
KB_CLIENT_MAC=

client_id=
client_secret=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ATLAS_CREDENTIAL_ENCRYPTION_KEY=

# Laboratory: no broker credentials are used. Set absolute paths on VPS.
LAB_DB_PATH=/var/lib/atlas/lab.sqlite
LAB_PYTHON=/opt/atlas/.venv-lab/bin/python
LAB_SOURCE=NAVER
