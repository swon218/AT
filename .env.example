kiwoom_app_key=
kiwoom_secret_key=
KIWOOM_ORDERS_ENABLED=false

toss_api_key=
toss_secret_key=
TOSS_ORDERS_ENABLED=false

NH_app_key=
NH_secret_key=
NH_ORDERS_ENABLED=false
# 나무 PLUG 운영 주소. 모의 계좌 사용 시 https://moapi.nhplug.com:8443
NH_API_HOST=https://api.nhplug.com:8443

KB_app_key=
KB_secret_key=
KB_ORDERS_ENABLED=false
# KB 요청 dataHeader에 넣을 실제 VPS 송신 IP와 네트워크 인터페이스 MAC
KB_CLIENT_IP=
KB_CLIENT_MAC=

client_id=
client_secret=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ATLAS_CREDENTIAL_ENCRYPTION_KEY=

# Laboratory: no broker credentials are used. Set absolute paths on VPS.
LAB_DB_PATH=/var/lib/atlas/lab.sqlite
LAB_PYTHON=/opt/atlas/.venv-lab/bin/python
LAB_SOURCE=NAVER

# Node/Fastify only. Use the actual VPS Node environment file, not this example.
AI_ENABLED=true
AI_PUBLIC_ORIGIN=http://127.0.0.1:5173
AI_INTERNAL_URL=http://127.0.0.1:8010
# Shared only between Node and the dedicated AI process; generate at deployment (>=32 characters).
AI_INTERNAL_SECRET=
# Node only; server-issued signed HttpOnly visitor cookie (>=32 characters).
AI_GUEST_COOKIE_SECRET=
AI_GUEST_DAYS=7

# Dedicated Python AI env ONLY. Never copy the broker environment into this process.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_CALLBACK_URL=http://127.0.0.1:3000/api/internal/agent/events
# Explicitly copy ONLY the required Naver news credential pair to the AI env at deployment.
# legacy: existing developer-center key; hub: NEW API HUB credentials, never interchangeable.
AI_NAVER_MODE=legacy
AI_NAVER_CLIENT_ID=
AI_NAVER_CLIENT_SECRET=
AI_ROUNDS=8
AI_TOOL_CALLS=12
AI_EXTERNAL_REQUESTS=8
AI_SYMBOLS=6
AI_ARTICLES=60
AI_SCREEN_SYMBOLS=3000
AI_TOKENS=40000
AI_OUTPUT_TOKENS=2048
AI_SECONDS=120
AI_TOOL_SECONDS=12
AI_CORRECTIONS=2
# Conservative budget accounting rates, NOT the current tariff or guaranteed bill.
AI_INPUT_USD_PER_MILLION=1.0
AI_OUTPUT_USD_PER_MILLION=4.0
AI_MAX_USD=0.25
# XKRX calendar validation horizon: review holidays/special sessions before extending.
AI_CALENDAR_THROUGH=2026-12-31

# Vercel server function env ONLY: actual HTTPS VPS reverse proxy origin (no trailing path).
ATLAS_API_ORIGIN=
