{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/screener.js": { "maxDuration": 30 }, "api/agent-proxy.js": { "maxDuration": 45 } },
  "rewrites": [
    {
      "source": "/api/agent/:atlas_route*",
      "destination": "/api/agent-proxy?__atlas_route=:atlas_route*"
    }
  ]
}
